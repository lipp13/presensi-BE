# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Konfigurasi Kantor & Toleransi Lokasi Presensi (Configurable)
OFFICE_NAME="Direktorat Bina Teknik Sumber Daya Air"
OFFICE_LATITUDE=-6.899380
OFFICE_LONGITUDE=107.618610
OFFICE_RADIUS_METERS=100
MAX_GPS_ACCURACY_METERS=50

# Telegram Bot Logger Configuration (Opsional untuk Real-time Admin Monitoring)
# Dapatkan Token dari @BotFather dan Chat ID dari @userinfobot atau grup admin
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Frontend URL Configuration (Untuk redirect tautan reset password)
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_URL=http://localhost:5173/reset-password
